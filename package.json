{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "architecture": "node scripts/check-architecture.mjs",
    "test:domain": "node --experimental-strip-types --test lib/domain/*.test.ts",
    "test:application": "node --experimental-strip-types --test lib/application/orchestration/*.test.ts lib/application/use-cases/*.test.ts",
    "test:adapters": "node --experimental-strip-types --test lib/infrastructure/d1/*.test.ts lib/infrastructure/scientific/*.test.ts lib/infrastructure/trends/*.test.ts lib/infrastructure/llm/*.test.ts lib/infrastructure/pdf/*.test.ts",
    "eval:reviewer": "node --experimental-strip-types scripts/evals/run-routerai-reviewer-eval.ts",
    "check": "npm run architecture && npm run lint && npm run typecheck && npm run test:domain && npm run test:application && npm run test:adapters && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
