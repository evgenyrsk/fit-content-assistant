# Copy to .env.local. Never commit real values.
LLM_PROVIDER=openai

# Direct OpenAI adapter
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_CONTENT=
OPENAI_VECTOR_STORE_ID=

# OpenRouter adapter. Model slugs are configured per pipeline role.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_RESEARCH=
OPENROUTER_MODEL_CONTENT=

# Scientific metadata providers
PUBMED_API_KEY=
CROSSREF_MAILTO=

# Keep false until a real, licensed trend source is connected.
ENABLE_LIVE_TRENDS=false
