# Copy to .env.local. Never commit real values.
LLM_PROVIDER=openai
LLM_BUDGET_PROFILE=economy

# Direct OpenAI adapter
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_CONTENT=
OPENAI_VECTOR_STORE_ID=

# OpenRouter adapter. Model slugs are configured per pipeline role.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_RESEARCH=
OPENROUTER_MODEL_CONTENT=

# Scientific metadata providers
PUBMED_API_KEY=
NCBI_EMAIL=
CROSSREF_MAILTO=

# Google Trends RSS works as a public live proxy. Meta sources require tokens.
TREND_REGION=RU
THREADS_ACCESS_TOKEN=
THREADS_API_VERSION=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=
