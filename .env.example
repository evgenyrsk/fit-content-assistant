# Copy to .env.local. Never commit real values.
LLM_PROVIDER=routerai
LLM_BUDGET_PROFILE=economy
LLM_RESEARCH_MODEL=
LLM_CONTENT_MODEL=

# Direct OpenAI adapter
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_CONTENT=
OPENAI_VECTOR_STORE_ID=

# OpenRouter adapter. Model slugs are configured per pipeline role.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_RESEARCH=openai/gpt-5-mini
OPENROUTER_MODEL_CONTENT=google/gemini-2.5-flash-lite

# RouterAI adapter. The API key is server-only and must never use a master key.
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL_RESEARCH=openai/gpt-5-mini
ROUTERAI_MODEL_CONTENT=deepseek/deepseek-v3.2

# Scientific metadata providers
PUBMED_API_KEY=
NCBI_EMAIL=
CROSSREF_MAILTO=

# Google Trends RSS works as a public live proxy. Meta sources require tokens.
TREND_REGION=RU
# Long-lived tokens are server-only secrets. Never expose them to client code.
THREADS_ACCESS_TOKEN=
THREADS_API_VERSION=
# `development` is the normal personal mode. Use `live` only after an approved public rollout.
THREADS_APP_MODE=development
# Optional ISO date used only for an early renewal warning; never inferred from the token.
THREADS_TOKEN_EXPIRES_AT=
# Page Access Token for the Facebook Page linked to the professional IG account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=
